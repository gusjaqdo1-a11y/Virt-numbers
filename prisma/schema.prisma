generator client { provider = "prisma-client-js" }
datasource db { provider = "mongodb" url = env("MONGODB_URI") }

enum Role { USER ADMIN DEVELOPER }
enum OrderStatus { PENDING ACTIVE COMPLETED CANCELLED FAILED }
enum PaymentStatus { PENDING PAID EXPIRED FAILED }
enum ProviderName { FIVESIM SMS_TIGER }
enum TransactionType { DEPOSIT PURCHASE REFUND ADJUSTMENT }
enum TicketStatus { OPEN IN_PROGRESS RESOLVED CLOSED }

model User {
  id String @id @default(cuid()) @map("_id")
  email String @unique
  passwordHash String?
  googleId String? @unique
  name String?
  role Role @default(USER)
  balance Float @default(0)
  suspended Boolean @default(false)
  emailVerified Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders Order[]
  transactions Transaction[]
  apiKeys ApiKey[]
  priceRules PriceRule[]
  pushTokens PushToken[]
  payments Payment[]
  notifications Notification[]
  supportTickets SupportTicket[]
  auditLogs AuditLog[]
}
model Country {
  id String @id @default(cuid()) @map("_id")
  name String
  iso String @unique
  dialCode String
  active Boolean @default(true)
  services Service[]
  priceRules PriceRule[]
}
model Service {
  id String @id @default(cuid()) @map("_id")
  countryId String
  name String
  slug String
  basePrice Float
  active Boolean @default(true)
  country Country @relation(fields:[countryId], references:[id], onDelete:Cascade)
  orders Order[]
  priceRules PriceRule[]
  @@unique([countryId,slug])
  @@index([countryId,active])
}
model Order {
  id String @id @default(cuid()) @map("_id")
  userId String
  serviceId String
  provider ProviderName
  providerOrderId String?
  phoneNumber String?
  status OrderStatus @default(PENDING)
  price Float
  smsCode String?
  smsText String?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  service Service @relation(fields:[serviceId],references:[id],onDelete:Cascade)
  transaction Transaction?
  @@index([userId,status])
  @@index([providerOrderId])
}
model Transaction {
  id String @id @default(cuid()) @map("_id")
  userId String
  orderId String? @unique
  type TransactionType
  amount Float
  currency String @default("USD")
  reference String @unique
  note String?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  order Order? @relation(fields:[orderId],references:[id])
  @@index([userId,createdAt])
}
model ApiKey {
  id String @id @default(cuid()) @map("_id")
  userId String
  name String
  keyPrefix String
  keyHash String @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model PriceRule {
  id String @id @default(cuid()) @map("_id")
  userId String?
  serviceId String?
  countryId String?
  developerId String?
  price Float
  markup Float @default(0)
  user User? @relation(fields:[userId],references:[id],onDelete:Cascade)
  service Service? @relation(fields:[serviceId],references:[id],onDelete:Cascade)
  country Country? @relation(fields:[countryId],references:[id],onDelete:Cascade)
  @@index([userId,serviceId,countryId])
  @@index([developerId,serviceId,countryId])
}
model Payment {
  id String @id @default(cuid()) @map("_id")
  userId String
  amount Float
  coin String
  network String
  address String
  checkoutUrl String?
  status PaymentStatus @default(PENDING)
  expiresAt DateTime
  externalId String? @unique
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,status])
}
model PushToken {
  id String @id @default(cuid()) @map("_id")
  userId String
  token String @unique
  platform String
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model Notification {
  id String @id @default(cuid()) @map("_id")
  userId String?
  title String
  body String
  data String?
  readAt DateTime?
  createdAt DateTime @default(now())
  user User? @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,createdAt])
}
model SupportTicket {
  id String @id @default(cuid()) @map("_id")
  userId String
  subject String
  message String
  email String
  status TicketStatus @default(OPEN)
  adminReply String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model VerificationToken {
  id String @id @default(cuid()) @map("_id")
  email String
  tokenHash String
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([email])
}
model PasswordReset {
  id String @id @default(cuid()) @map("_id")
  email String
  tokenHash String
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([email])
}
model AuditLog {
  id String @id @default(cuid()) @map("_id")
  userId String?
  action String
  target String?
  metadata String?
  createdAt DateTime @default(now())
  user User? @relation(fields:[userId],references:[id],onDelete:SetNull)
  @@index([userId,createdAt])
}
model Setting {
  id String @id @default(cuid()) @map("_id")
  key String @unique
  value String
}
